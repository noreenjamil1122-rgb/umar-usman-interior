# MongoDB Connection (Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/wallpaper_manager?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_32_character_string_here
JWT_EXPIRES_IN=7d

# App & Business Branding
NEXT_PUBLIC_APP_NAME="Wallpaper Manager"
NEXT_PUBLIC_BUSINESS_NAME="Umar Usman Interior"

# Vercel Blob (for logo uploads)
BLOB_READ_WRITE_TOKEN=

# EmailJS Configuration
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TO_EMAIL=
